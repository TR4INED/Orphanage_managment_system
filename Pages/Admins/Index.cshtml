@page
@model OrphanageWeb.Pages.Admins.IndexModel
@{
    ViewData["Title"] = "Admins";
}

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Admins</h1>
            <p class="page-subtitle">Live data from SQL Server (OrphanageDB).</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="surface card" style="border-color: rgba(239, 68, 68, 0.55); background: rgba(239, 68, 68, 0.08);">
            <h3 class="card-title">Database error</h3>
            <p class="card-meta">@Model.ErrorMessage</p>
        </div>
    }

    <div class="surface">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>A_ID</th>
                        <th>Phone</th>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Admins)
                    {
                        <tr>
                            <td>@a.A_ID</td>
                            <td>@a.A_Pno</td>
                            <td>@a.A_name</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
