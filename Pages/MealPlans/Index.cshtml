@page
@model OrphanageWeb.Pages.MealPlans.IndexModel
@{
    ViewData["Title"] = "Meal Plans";
}

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Meal Plans</h1>
            <p class="page-subtitle">Live data from SQL Server (OrphanageDB).</p>
        </div>
        <div class="actions">
            <a class="btn btn-primary" asp-page="/MealPlans/Create">Add Meal Plan</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="surface card" style="border-color: rgba(239, 68, 68, 0.55); background: rgba(239, 68, 68, 0.08);">
            <h3 class="card-title">Database error</h3>
            <p class="card-meta">@Model.ErrorMessage</p>
        </div>
    }

    <div class="surface">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>MP_ID</th>
                        <th>Meal Plan</th>
                        <th>Orphan (O_ID)</th>
                        <th>Served To</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mp in Model.Mealplans)
                    {
                        <tr>
                            <td>@mp.MP_ID</td>
                            <td>@mp.MP_meal</td>
                            <td>@mp.O_ID</td>
                            <td><span class="pill">@mp.ServedCount</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
