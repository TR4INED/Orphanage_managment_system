@page
@model OrphanageWeb.Pages.Schools.CreateModel
@{
    ViewData["Title"] = "Add School";
}

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Add School</h1>
            <p class="page-subtitle">Creates a real row in SQL Server (OrphanageDB).</p>
        </div>
        <div class="actions">
            <a class="btn" asp-page="/Schools/Index">Back to list</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="surface card" style="border-color: rgba(239, 68, 68, 0.55); background: rgba(239, 68, 68, 0.08);">
            <h3 class="card-title">Database error</h3>
            <p class="card-meta">@Model.ErrorMessage</p>
        </div>
    }

    <div class="surface form">
        <form method="post">
            <div class="validation" asp-validation-summary="All"></div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Input.Name">School Name</label>
                    <input asp-for="Input.Name" placeholder="e.g., Nile School" />
                    <span class="validation" asp-validation-for="Input.Name"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Address">Address</label>
                    <input asp-for="Input.Address" placeholder="City / Area" />
                    <span class="validation" asp-validation-for="Input.Address"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" type="email" placeholder="school@mail.com" />
                    <span class="validation" asp-validation-for="Input.Email"></span>
                </div>
            </div>

            <div class="actions" style="margin-top: 14px;">
                <button class="btn btn-primary" type="submit">Save</button>
                <a class="btn" asp-page="/Schools/Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
