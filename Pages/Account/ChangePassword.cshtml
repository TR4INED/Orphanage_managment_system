@page
@model OrphanageWeb.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="page" style="padding-top: 14px;">
    <div class="surface" style="max-width: 560px; margin: 0 auto; padding: 18px;">
        <h1 class="page-title" style="margin-bottom: 6px;">Change Password</h1>
        <p class="page-subtitle" style="margin-top: 0;">Update your password.</p>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="surface card" style="border-color: rgba(34, 197, 94, 0.55); background: rgba(34, 197, 94, 0.10); margin-top: 14px;">
                <h3 class="card-title">Done</h3>
                <p class="card-meta">@Model.StatusMessage</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="surface card" style="border-color: rgba(239, 68, 68, 0.55); background: rgba(239, 68, 68, 0.08); margin-top: 14px;">
                <h3 class="card-title">Error</h3>
                <p class="card-meta">@Model.ErrorMessage</p>
            </div>
        }

        <div class="form" style="padding: 0; margin-top: 14px;">
            <form method="post">
                <div class="validation" asp-validation-summary="All"></div>

                <div class="form-grid" style="grid-template-columns: 1fr;">
                    <div class="field">
                        <label asp-for="Input.CurrentPassword">Current password</label>
                        <input asp-for="Input.CurrentPassword" type="password" />
                        <span class="validation" asp-validation-for="Input.CurrentPassword"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.NewPassword">New password</label>
                        <input asp-for="Input.NewPassword" type="password" />
                        <span class="validation" asp-validation-for="Input.NewPassword"></span>
                    </div>
                </div>

                <div class="actions" style="margin-top: 14px;">
                    <button class="btn btn-primary" type="submit">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
