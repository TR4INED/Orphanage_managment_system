@page
@model OrphanageWeb.Pages.Orphans.CreateModel
@{
    ViewData["Title"] = "Add Orphan";
}

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Add Orphan</h1>
            <p class="page-subtitle">Creates a real row in SQL Server (OrphanageDB).</p>
        </div>
        <div class="actions">
            <a class="btn" asp-page="/Orphans/Index">Back to list</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="surface card" style="border-color: rgba(239, 68, 68, 0.55); background: rgba(239, 68, 68, 0.08);">
            <h3 class="card-title">Database error</h3>
            <p class="card-meta">@Model.ErrorMessage</p>
        </div>
    }

    <div class="surface form">
        <form method="post">
            <div class="validation" asp-validation-summary="All"></div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Input.FirstName">First Name</label>
                    <input asp-for="Input.FirstName" placeholder="e.g., Ali" />
                    <span class="validation" asp-validation-for="Input.FirstName"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.LastName">Last Name</label>
                    <input asp-for="Input.LastName" placeholder="e.g., Hassan" />
                    <span class="validation" asp-validation-for="Input.LastName"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Gender">Gender</label>
                    <select asp-for="Input.Gender">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <span class="validation" asp-validation-for="Input.Gender"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.DateOfBirth">Date of Birth</label>
                    <input asp-for="Input.DateOfBirth" type="date" />
                    <span class="validation" asp-validation-for="Input.DateOfBirth"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.AdminId">Admin (A_ID)</label>
                    <input asp-for="Input.AdminId" type="number" min="1" placeholder="e.g., 1" />
                    <span class="validation" asp-validation-for="Input.AdminId"></span>
                </div>
            </div>

            <div class="actions" style="margin-top: 14px;">
                <button class="btn btn-primary" type="submit">Save</button>
                <a class="btn" asp-page="/Orphans/Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
